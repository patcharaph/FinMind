# ============================================
# FinMind Server — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Server ---
PORT=3000

# --- AI (OpenRouter) ---
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# AI model to use (optional, defaults to google/gemini-2.5-flash)
# Examples: google/gemini-2.5-flash, anthropic/claude-3.5-sonnet, openai/gpt-4o
# ADVISOR_MODEL=google/gemini-2.5-flash

# --- CORS (optional) ---
# Comma-separated allowed origins. Default: * (all)
# CORS_ORIGINS=http://localhost:5173,https://finmind.app

# --- Database ---
# Option 1: SQLite (default, for development)
# DB_PATH=./database.sqlite

# Option 2: Supabase (PostgreSQL, for production)
# Set USE_SUPABASE=true to use Supabase instead of SQLite
# USE_SUPABASE=true
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_here
